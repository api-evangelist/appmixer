{
  "opencollection": "1.0.0",
  "info": {
    "name": "Appmixer Accounts Messages API",
    "version": "6.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Appmixer List unprocessed messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{tenant}.appmixer.cloud/unprocessed-messages"
          },
          "docs": "Get the list of unprocessed messages."
        },
        {
          "info": {
            "name": "Appmixer Reprocess a message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{tenant}.appmixer.cloud/unprocessed-messages/:messageId",
            "params": [
              {
                "name": "messageId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Put an unprocessed message back into the Appmixer engine."
        },
        {
          "info": {
            "name": "Appmixer Delete an unprocessed message",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.{tenant}.appmixer.cloud/unprocessed-messages/:messageId",
            "params": [
              {
                "name": "messageId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a specific unprocessed message."
        }
      ]
    }
  ],
  "bundled": true
}