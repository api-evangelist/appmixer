{
  "opencollection": "1.0.0",
  "info": {
    "name": "Appmixer Accounts People Tasks API",
    "version": "6.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "People Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Appmixer List people tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{tenant}.appmixer.cloud/people-task/tasks",
            "params": [
              {
                "name": "role",
                "value": "",
                "type": "query",
                "description": "Filter tasks by role"
              }
            ]
          },
          "docs": "Get all tasks of the authenticated user. Can filter by role (approver or requester)."
        }
      ]
    }
  ],
  "bundled": true
}